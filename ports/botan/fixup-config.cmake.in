# Upstream exports one configuration; vcpkg installs separate Release and Debug binaries.
foreach(_botan_target IN ITEMS botan::botan botan::botan-static)
    if(TARGET "${_botan_target}")
        set_property(TARGET "${_botan_target}" PROPERTY IMPORTED_CONFIGURATIONS RELEASE)
        foreach(_botan_property IN ITEMS IMPORTED_LOCATION IMPORTED_IMPLIB)
            get_target_property(_botan_release "${_botan_target}" "${_botan_property}")
            if(_botan_release)
                set_property(TARGET "${_botan_target}" PROPERTY "${_botan_property}_RELEASE" "${_botan_release}")
                set_property(TARGET "${_botan_target}" PROPERTY "${_botan_property}_NOCONFIG" "${_botan_release}")
                if(@BOTAN_HAS_DEBUG@)
                    string(REPLACE "${_Botan_PREFIX}/" "${_Botan_PREFIX}/debug/" _botan_debug "${_botan_release}")
                    set_property(TARGET "${_botan_target}" PROPERTY "${_botan_property}_DEBUG" "${_botan_debug}")
                endif()
            endif()
        endforeach()
        if(@BOTAN_HAS_DEBUG@)
            set_property(TARGET "${_botan_target}" APPEND PROPERTY IMPORTED_CONFIGURATIONS DEBUG)
        endif()
        set_target_properties("${_botan_target}" PROPERTIES
            MAP_IMPORTED_CONFIG_RELWITHDEBINFO RELEASE
            MAP_IMPORTED_CONFIG_MINSIZEREL RELEASE)
    endif()
endforeach()
unset(_botan_target)
unset(_botan_property)
unset(_botan_release)
unset(_botan_debug)
