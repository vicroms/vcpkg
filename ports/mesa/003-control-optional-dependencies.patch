diff --git a/meson.build b/meson.build
index 37f2fd4..c411712 100644
--- a/meson.build
+++ b/meson.build
@@ -1865,10 +1865,7 @@ endif
 dep_m = cc.find_library('m', required : false)
 
 if host_machine.system() == 'windows'
-  dep_regex = meson.get_compiler('c').find_library('regex', required : false)
-  if not dep_regex.found()
-    dep_regex = declare_dependency(compile_args : ['-DNO_REGEX'])
-  endif
+  dep_regex = meson.get_compiler('c').find_library('tre', required : true)
 else
   dep_regex = null_dep
 endif
@@ -1919,7 +1916,7 @@ endif
 allow_fallback_for_libdrm = get_option('allow-fallback-for').contains('libdrm')
 
 with_gallium_drisw_kms = false
-if system_has_kms_drm
+if system_has_kms_drm and (not with_platform_android or with_dri2 or with_dri or with_gbm or with_any_vk or with_gallium_kmsro)
   dep_libdrm = dependency(
     'libdrm', version : '>=' + _drm_ver,
     required : with_dri2 or with_dri or with_gbm,
@@ -1956,7 +1953,11 @@ foreach d : _libdrm_checks
   endif
 endforeach
 
-dep_libudev = dependency('libudev', required : false)
+if system_has_kms_drm and (not with_platform_android or with_any_vk or with_gallium_kmsro)
+  dep_libudev = dependency('libudev', required : false)
+else
+  dep_libudev = null_dep
+endif
 if dep_libudev.found()
   pre_args += '-DHAVE_LIBUDEV'
 endif
@@ -2147,9 +2148,13 @@ if host_machine.system() == 'windows'
   dep_version = cpp.find_library('version')
 endif
 
-dep_elf = dependency('libelf', required : false)
-if not with_platform_windows and not dep_elf.found()
-  dep_elf = cc.find_library('elf', required : false)
+if host_machine.system() == 'windows' or host_machine.system() == 'darwin'
+  dep_elf = null_dep
+else
+  dep_elf = dependency('libelf', required : false)
+  if not dep_elf.found()
+    dep_elf = cc.find_library('elf', required : false)
+  endif
 endif
 if dep_elf.found()
   pre_args += '-DUSE_LIBELF'
