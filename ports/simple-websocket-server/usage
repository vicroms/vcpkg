The package simple-websocket-server is header-only and can be used from CMake via:

find_path(
    SIMPLE_WEBSOCKET_SERVER_INCLUDE_DIRS
    "simple-websocket-server/server_ws.hpp"
    REQUIRED
)

find_package(OpenSSL REQUIRED)
find_package(Threads REQUIRED)

target_include_directories(main PRIVATE
    ${SIMPLE_WEBSOCKET_SERVER_INCLUDE_DIRS}
)

target_link_libraries(main PRIVATE OpenSSL::SSL OpenSSL::Crypto Threads::Threads)

if(WIN32)
    target_link_libraries(main PRIVATE ws2_32 crypt32)
endif()

This port always uses standalone Asio, including for direct header inclusion.
No consumer backend-selection compile definition is needed.
